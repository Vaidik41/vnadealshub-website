
---
import Header from "../components/Header.astro";

const email = "vnadealshub.official@gmail.com";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Disclaimer | VnA Deals Hub</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #1f2937;
      line-height: 1.7;
    }

    
header {
  background: #ffffff;
  padding: 18px 4.5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

.logo {
  font-size: 30px;
  font-weight: bold;
  color: #2563eb;
  white-space: nowrap;
}



header .logo,
header .logo a,
header .logo a:link,
header .logo a:visited {
  text-decoration: none !important;
  border-bottom: none !important;
}




nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 22px;
}

nav a {
  text-decoration: none;
  color: #374151;
  font-size: 16px;
  font-weight: 600;
  white-space: nowrap;
}

nav a:hover {
  color: #2563eb;
}

@media (max-width: 900px) {
  header {
    justify-content: center;
  }

  nav {
    justify-content: center;
    gap: 14px;
  }
}

    .hero {
  margin: 35px 4.5%;
  padding: 85px 25px;
  min-height: 404px;
  box-sizing: border-box;
  text-align: center;
  color: white;
  background: linear-gradient(135deg, #111827, #2563eb);
  border-radius: 22px;
}

    .hero h1 {
      font-size: 46px;
      margin-bottom: 12px;
    }

    .hero p {
      color: #e5e7eb;
      font-size: 18px;
    }

    main {
      max-width: 1000px;
      margin: 60px auto;
      padding: 0 4.5%;
    }

    .disclaimer-card {
      background: white;
      padding: 40px;
      border-radius: 18px;
      box-shadow: 0 5px 22px rgba(0,0,0,0.045);
    }

    .updated {
      color: #6b7280;
      font-size: 14px;
      margin-bottom: 30px;
    }

    .section {
      margin-bottom: 30px;
    }

    .section h2 {
      color: #2563eb;
      font-size: 23px;
      margin-bottom: 10px;
    }

    .section p {
      color: #4b5563;
      margin-bottom: 10px;
    }

    .section ul {
      padding-left: 25px;
      color: #4b5563;
    }

    .contact-link {
      color: #2563eb;
      font-weight: bold;
      text-decoration: none;
    }

    .contact-link:hover {
      text-decoration: underline;
    }

    footer {
      margin-top: 70px;
      padding: 30px 20px;
      text-align: center;
      background: #111827;
      color: #d1d5db;
    }

    footer a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
    }

    footer a:hover {
      color: #60a5fa;
    }

    @media (max-width: 750px) {
      header {
        justify-content: center;
      }

      nav {
        justify-content: center;
        gap: 15px;
      }

      nav a {
        font-size: 14px;
      }

      .logo {
        font-size: 25px;
      }

.hero {
        padding: 60px 20px;
      }

      .hero h1 {
        font-size: 34px;
      }

      .disclaimer-card {
        padding: 25px;
      }

      .section h2 {
        font-size: 21px;
      }
    }
  </style>
</head>

<body>

 <Header />

  <section class="hero">
    <h1>Disclaimer</h1>
    <p>Important information about using VnA Deals Hub.</p>
  </section>

  <main>
    <div class="disclaimer-card">

      <p class="updated">Last Updated: November 9, 2026</p>

      <section class="section">
        <h2>1. General Information</h2>
        <p>
          The information provided on VnA Deals Hub is
          intended for general informational and product
          discovery purposes.
        </p>
        <p>
          We aim to provide useful and accurate information,
          but we do not guarantee that all content is
          complete, accurate or up to date.
        </p>
      </section>

      <section class="section">
        <h2>2. Product Information</h2>
        <p>
          Product descriptions, specifications, images
          and other details may be obtained from retailers
          or other sources.
        </p>
        <p>
          Product details, availability and specifications
          may change. Always check the retailer's website
          for the latest information before purchasing.
        </p>
      </section>

      <section class="section">
        <h2>3. Prices and Availability</h2>
        <p>
          Prices, discounts and product availability
          displayed or discussed on our website may change
          without notice.
        </p>
        <p>
          The final price and availability are determined
          by the retailer at the time of purchase.
        </p>
      </section>

      <section class="section">
        <h2>4. Affiliate Links</h2>
        <p>
          VnA Deals Hub participates in affiliate marketing
          programs. Some links on this website may be
          affiliate links.
        </p>
        <p>
          We may earn a commission when visitors purchase
          products through qualifying affiliate links,
          at no additional cost to them.
        </p>
        <p>
          Affiliate relationships do not guarantee that
          every product will be suitable for every visitor.
        </p>
      </section>

      <section class="section">
        <h2>5. External Websites</h2>
        <p>
          Our website may contain links to third-party
          websites, including online retailers.
        </p>
        <p>
          We do not control the content, policies,
          services or practices of these external websites.
          Visitors should review their terms and privacy
          policies before using them.
        </p>
        <p>
          We are not responsible for transactions made
          directly with third-party retailers.
        </p>
      </section>

      <section class="section">
        <h2>6. No Professional Advice</h2>
        <p>
          Information on this website is not intended
          to replace professional advice.
        </p>
        <p>
          Visitors should make their own decisions and
          seek appropriate professional guidance when
          necessary.
        </p>
      </section>

      <section class="section">
        <h2>7. Limitation of Responsibility</h2>
        <p>
          To the extent permitted by applicable law,
          VnA Deals Hub is not responsible for losses
          arising from reliance on website information
          or from purchases made through third-party
          retailers.
        </p>
      </section>

      <section class="section">
        <h2>8. Changes to This Disclaimer</h2>
        <p>
          We may update this Disclaimer when our website
          or services change. Updated versions will be
          published on this page.
        </p>
      </section>

      <section class="section">
        <h2>9. Contact Us</h2>
        <p>
          For questions about this Disclaimer, contact us:
        </p>
        <p>
          <a class="contact-link" href={`mailto:${email}`}>
            {email}
          </a>
        </p>
      </section>

    </div>
  </main>

  <footer>
    <p>© 2026 VnA Deals Hub. All rights reserved.</p>

    <p style="margin-top: 12px;">
      <a href="/">Home</a>
      <a href="/about">About Us</a>
      <a href="/contact">Contact Us</a>
      <a href="/privacy">Privacy Policy</a>
    </p>
  </footer>

</body>
</html>
