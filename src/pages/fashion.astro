
---
import Header from "../components/Header.astro";
import products from "../products/products.js";

const fashionProducts = products.filter(
  (product) => product.category === "Fashion"
);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fashion Products | VnA Deals Hub</title>
</head>

<body>
  <Header />

  <section class="section">
    <h1 class="section-title">Fashion Products</h1>

    {fashionProducts.length > 0 ? (
      <div class="product-grid">
        {fashionProducts.map((product) => (
          <a
            href={`/product/${product.slug}`}
            class="product-card"
          >
            <div class="product-image">
              <img src={product.image} alt={product.name} />
            </div>

            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.description}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-message">Fashion products coming soon!</p>
    )}
  </section>
</body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: Arial, sans-serif;
    background: #f8fafc;
    color: #1e293b;
    line-height: 1.6;
  }

  .section {
    padding: 45px 4.5%;
  }

  .section-title {
    font-size: 34px;
    margin-bottom: 35px;
    color: #0f172a;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  .product-card {
    display: block;
    background: white;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
    transition: 0.3s;
    text-decoration: none;
    color: inherit;
  }

  .product-card:hover {
    transform: translateY(-5px);
  }

  .product-image {
    height: 210px;
    background: #f1f5f9;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 15px;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-info {
    padding: 20px;
  }

  .product-info h3 {
    margin-bottom: 8px;
  }

  .product-info p {
    color: #64748b;
  }

  .empty-message {
    color: #64748b;
    font-size: 17px;
  }

  @media (max-width: 800px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 550px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .section {
      padding: 35px 5%;
    }
  }
</style>

