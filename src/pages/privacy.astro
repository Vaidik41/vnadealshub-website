
---
import Header from "../components/Header.astro";

const email = "vnadealshub.official@gmail.com";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Privacy Policy | VnA Deals Hub</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #1f2937;
      line-height: 1.7;
    }

    /* Hero - Standardized with Contact page */
    .hero {
  margin: 35px 4.5%;
  padding: 85px 25px;
  min-height: 404px;
  box-sizing: border-box;
  text-align: center;
  color: white;
  background: linear-gradient(135deg, #111827, #2563eb);
  border-radius: 22px;
}

    .hero h1 {
      font-size: 48px;
      margin-bottom: 18px;
    }

    .hero p {
      max-width: 700px;
      margin: auto;
      font-size: 19px;
      color: #e5e7eb;
    }

    main {
      max-width: 1000px;
      margin: 60px auto;
      padding: 0 4.5%;
    }

    .policy-card {
      background: white;
      padding: 40px;
      border-radius: 18px;
      box-shadow: 0 5px 22px rgba(0,0,0,0.045);
    }

    .updated {
      color: #6b7280;
      margin-bottom: 30px;
      font-size: 14px;
    }

    .policy-section {
      margin-bottom: 30px;
    }

    .policy-section h2 {
      color: #2563eb;
      font-size: 23px;
      margin-bottom: 10px;
    }

    .policy-section p {
      color: #4b5563;
      margin-bottom: 10px;
    }

    .policy-section ul {
      padding-left: 25px;
      color: #4b5563;
    }

    .back-btn {
      display: inline-block;
      margin-top: 15px;
      padding: 14px 28px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      font-weight: bold;
      border-radius: 9px;
      transition: 0.3s;
    }

    .back-btn:hover {
      background: #1d4ed8;
      transform: translateY(-2px);
    }

    footer {
      margin-top: 70px;
      padding: 30px 20px;
      text-align: center;
      background: #111827;
      color: #d1d5db;
    }

    footer a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
    }

    footer a:hover {
      color: #60a5fa;
    }

    /* Mobile */
    @media (max-width: 750px) {
      .hero {
        padding: 60px 20px;
      }

      .hero h1 {
        font-size: 34px;
      }

      .hero p {
        font-size: 16px;
      }

      .policy-card {
        padding: 25px;
      }

      .policy-section h2 {
        font-size: 21px;
      }
    }
  </style>
</head>

<body>

  <Header />

  <section class="hero">
    <h1>Privacy Policy</h1>
    <p>Your privacy matters to VnA Deals Hub.</p>
  </section>

  <main>
    <div class="policy-card">

      <p class="updated">Last Updated: November 9, 2026</p>

      <section class="policy-section">
        <h2>1. Introduction</h2>
        <p>
          Welcome to VnA Deals Hub. This Privacy Policy explains
          how information may be collected, used and protected
          when you visit our website.
        </p>
      </section>

      <section class="policy-section">
        <h2>2. Information We Collect</h2>
        <p>
          We do not currently provide user accounts or registration
          on this website.
        </p>
        <p>
          If you contact us by email, we may receive your email
          address and the information you choose to include
          in your message.
        </p>
        <p>
          Our website hosting provider may also process limited
          technical information, such as browser and server
          request data, to operate and secure the website.
        </p>
      </section>

      <section class="policy-section">
        <h2>3. How We Use Information</h2>
        <p>Information received may be used to:</p>
        <ul>
          <li>Respond to questions and business inquiries.</li>
          <li>Maintain and improve our website.</li>
          <li>Help protect the website against misuse.</li>
        </ul>
      </section>

      <section class="policy-section">
        <h2>4. Cookies and Tracking</h2>
        <p>
          Our website may use cookies or similar technologies
          through third-party services and external websites.
          Their use depends on the services you interact with.
        </p>
        <p>
          You can manage or disable cookies through your
          browser settings. Some website features on
          third-party services may be affected.
        </p>
      </section>

      <section class="policy-section">
        <h2>5. Affiliate Links and Third-Party Websites</h2>
        <p>
          VnA Deals Hub contains affiliate links, including
          links to Amazon. When you click an affiliate link,
          you may be redirected to a third-party website.
        </p>
        <p>
          Those websites may collect information and use
          cookies according to their own privacy policies.
          We do not control their data practices.
        </p>
      </section>

      <section class="policy-section">
        <h2>6. Data Security</h2>
        <p>
          We take reasonable steps to protect information
          handled through our website. However, no method
          of internet transmission or electronic storage
          can be guaranteed to be completely secure.
        </p>
      </section>

      <section class="policy-section">
        <h2>7. External Links</h2>
        <p>
          Our website may link to external websites.
          We are not responsible for the privacy practices
          or content of those websites.
        </p>
      </section>

      <section class="policy-section">
        <h2>8. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy when our
          website or services change. Any updated version
          will be published on this page.
        </p>
      </section>

      <section class="policy-section">
        <h2>9. Contact Us</h2>
        <p>
          If you have questions about this Privacy Policy,
          contact us at:
        </p>
        <p>
          <strong>{email}</strong>
        </p>
      </section>

    </div>
  </main>

  <footer>
    <p>© 2026 VnA Deals Hub. All rights reserved.</p>
    <p style="margin-top: 12px;">
      <a href="/">Home</a>
      <a href="/about">About Us</a>
      <a href="/contact">Contact Us</a>
      <a href="/privacy">Privacy Policy</a>
    </p>
  </footer>

</body>
</html>
